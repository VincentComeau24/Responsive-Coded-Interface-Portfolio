/* Basic Page Styling */

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background-color: white;
  color: #222222;
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.6;
}

img {
  max-width: 100%;
}

h1,
h2,
h3 {
  margin-top: 0;
}

h2 {
  font-size: 32px;
}

p {
  font-size: 17px;
}

/* Header */

header {
  background-color: #222222;
  color: white;
  padding: 20px;
  text-align: center;
}

header h1 {
  margin-bottom: 15px;
}

/* Navigation */

nav ul {
  display: flex;
  justify-content: center;
  gap: 25px;
  margin: 0;
  padding: 0;
  list-style: none;
}

nav a {
  color: white;
  font-weight: bold;
  text-decoration: none;
}

nav a:hover {
  color: #8fc5ff;
}

/* Main Sections */

section {
  width: 90%;
  max-width: 1000px;
  margin: auto;
  padding: 60px 20px;
}

/* Hero Section */

.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40px;
}

.hero-text {
  width: 55%;
}

.hero-text h2 {
  font-size: 45px;
}

.hero-image {
  width: 40%;
  text-align: center;
}

.hero-image img {
  width: 300px;
  height: 300px;
  border-radius: 50%;
  object-fit: cover;
}

/* Button */

.button {
  display: inline-block;
  margin-top: 15px;
  padding: 12px 22px;
  background-color: #2563eb;
  color: white;
  border-radius: 6px;
  font-weight: bold;
  text-decoration: none;
}

.button:hover {
  background-color: #163fa3;
}

/* About Section */

#about {
  background-color: #f4f4f4;
}

/* Skills Section */

.skills-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  padding: 0;
  list-style: none;
}

.skill-card {
  padding: 20px;
  background-color: #dcecff;
  border: 1px solid #aaccee;
  border-radius: 8px;
}

.skill-card:hover {
  background-color: #c8e0fa;
}

/* Projects Section */

#projects {
  background-color: #f4f4f4;
}

.project-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30px;
}

.project-card {
  padding: 20px;
  background-color: white;
  border: 1px solid #cccccc;
  border-radius: 8px;
}

.project-card img {
  width: 100%;
  height: 220px;
  object-fit: fill;
}

.project-card h3 {
  margin-top: 15px;
}

.project-card a {
  color: #2563eb;
  font-weight: bold;
}

.project-card:hover {
  border-color: #2563eb;
}

/* Contact Section */

#contact a {
  color: #2563eb;
  font-weight: bold;
  text-decoration: none;
}

#contact a:hover {
  text-decoration: underline;
}
/* Footer */

footer {
  padding: 25px;
  background-color: #222222;
  color: white;
  text-align: center;
}

footer p {
  margin: 5px;
  font-size: 14px;
}

/* Responsive Design */

@media screen and (max-width: 700px) {

  nav ul {
    flex-direction: column;
    gap: 10px;
  }

  .hero {
    flex-direction: column;
    text-align: center;
  }

  .hero-text,
  .hero-image {
    width: 100%;
  }

  .hero-text h2 {
    font-size: 36px;
  }

  .skills-list,
  .project-list {
    grid-template-columns: 1fr;
  }

  .hero-image img {
    width: 240px;
    height: 240px;
  }

}
